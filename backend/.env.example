PORT=5000
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@your-postgres-host:5432/umuco?sslmode=require
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_API_URL=http://localhost:5000
JWT_SECRET=replace-with-a-long-random-secret
# --- Brevo (recommended) ---
# In Brevo → SMTP & API → SMTP: copy the login email and the generated SMTP key.
# Make sure the AUTH_FROM_EMAIL domain is verified under Brevo → Senders & IPs.
BREVO_USER=your-brevo-login@example.com
BREVO_KEY=your-brevo-smtp-key
AUTH_FROM_EMAIL=no-reply@yourdomain.com
# Optional overrides (defaults already point to Brevo relay)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587

# --- Legacy Gmail fallback (leave blank if using Brevo) ---
# SMTP_USER=your-gmail-address@gmail.com
# SMTP_APP_PASSWORD=your-16-character-google-app-password
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Set this exact URL as an Authorized redirect URI in Google Cloud OAuth settings.
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
ADMIN_EMAIL=admin@umuco.rw
ADMIN_PASSWORD=Admin@12345
